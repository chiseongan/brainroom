rules_version = '2';

// BrainRoom Firestore 보안 규칙
// 게시: 저장소 루트에서 `npx firebase-tools deploy --only firestore:rules`
//       또는 Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 [게시]
// 시험: tests/rules/rules.test.mjs (에뮬레이터로 실제 규칙을 돌린다)
//
// - 팀원(student)과 교수자(prof)는 teams/{t}/members/{uid} 역할 문서로 구분한다.
//   역할 문서는 비밀 초대 코드가 맞을 때만 만들 수 있다. (RQ-1, ONRQ-5)
// - 명단의 팀원 한 명은 계정 하나만 쓴다: claims/{memberId} 를 먼저 만든 계정이 그 팀원이다.
// - 기록(items)은 공유 범위대로만 읽힌다: 나만 = 본인, 팀 = 팀원, 교수자까지 = 팀원+교수자. (RQ-6)
// - 교수자는 itemMeta로 횟수·목적만 보고, 원문은 '교수자까지' 기록만 본다. (RQ-11, RQ-12)
// - 방 삭제는 두 단계다: 팀장이 deleting 표시 → 하위 문서 삭제 → 팀 문서 삭제.
//   평소에는 지울 수 없는 변경 이력 등도 이 표시가 있을 때만 팀장이 지운다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function rolePath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
    function claimPath(t, m) { return /databases/$(database)/documents/teams/$(t)/claims/$(m); }
    function hasRole(t, r) { return signedIn() && exists(rolePath(t)) && get(rolePath(t)).data.role == r; }
    function isMember(t) { return hasRole(t, 'student'); }
    function isProf(t) { return hasRole(t, 'prof'); }
    function isOwner(t) { return signedIn() && get(teamPath(t)).data.ownerUid == request.auth.uid; }
    function tearingDown(t) { return isOwner(t) && get(teamPath(t)).data.get('deleting', false) == true; }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function changed(key) { return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]); }
    // 초대 코드가 맞고 만료 전인지 (expiresAt이 없는 예전 방의 링크는 다시 발급하기 전까지 만료되지 않는다)
    function validInvite(t, kind, code) {
      let s = get(/databases/$(database)/documents/teams/$(t)/secrets/$(kind)).data;
      return s.code == code && (s.get('expiresAt', null) == null || request.time.toMillis() < s.expiresAt);
    }
    function str(v, max) { return v is string && v.size() <= max; }
    function ownsClaimAfter(t, m) { return getAfter(claimPath(t, m)).data.uid == request.auth.uid; }
    // 동의: 약관·방침에 동의했고, 만 14세 미만이면 보호자가 승인해야 방을 만들거나 들어간다
    function consented() {
      let c = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('consent', {});
      return c.get('terms', false) == true && c.get('privacy', false) == true
        && (c.get('over14', false) == true
            || (c.get('guardianToken', '') != ''
                && get(/databases/$(database)/documents/guardianRequests/$(c.guardianToken)).data.status == 'approved'
                && get(/databases/$(database)/documents/guardianRequests/$(c.guardianToken)).data.childUid == request.auth.uid));
    }
    function safeId(v) { return v is string && v.matches('^[A-Za-z0-9_.:-]{1,200}$'); }
    function number(v) { return v is int || v is float; }
    function myMemberId(t) { return get(rolePath(t)).data.memberId; }

    // 명단 한 칸 (roster/{memberId}). 배열을 칸별로 검사하면 8명부터 규칙 평가 한도(1,000)를 넘어서 문서로 나눴다
    function validEntry(e, memberId) {
      return e.id == memberId && safeId(memberId) && str(e.name, 100)
        && e.color is string && e.color.matches('^#[0-9a-fA-F]{6}$')
        && !e.keys().hasAny(['email', 'photo']); // 명단에 이메일·사진을 두지 않는다 (필요 없는 개인정보)
    }

    // 기록 내용의 최소 검사 (Firestore 문서 한도 1MB 안에서 한 사람이 방을 망가뜨리지 못하게)
    function validRecord(d) {
      return d.visibility in ['me', 'team', 'prof']
        && d.type in ['link', 'memo', 'idea', 'ai', 'talk', 'work', 'search']
        && str(d.title, 1000)
        && str(d.get('content', ''), 50000)
        && str(d.get('url', ''), 4000)
        && (!d.get('url', '').matches('^[a-zA-Z][a-zA-Z0-9+.-]*:.*') || d.url.matches('^[hH][tT][tT][pP][sS]?://.*')) // javascript: 등 거부
        && number(d.createdAt) && d.createdAt <= request.time.toMillis() + 86400000 // 미래 시각으로 기록을 속이지 못하게
        && safeId(d.memberId)
        && (d.get('table', null) == null || (number(d.table.x) && number(d.table.y)));
    }

    // 새 기록: 본인이 작성자이고 명단에서 고른 자기 팀원 id로만 쓸 수 있다.
    // 예외: 기여 보정 요청을 다른 팀원이 확인해 '빠진 기여'를 추가할 때 (RQ-14)
    // 다른 팀원이 내 기록의 분류를 바꾸려면 그 기록에 대한 보정 요청을 확인하는 경우여야 한다 (RQ-14)
    function appliedCorrectionOk(t, id) {
      let c = get(/databases/$(database)/documents/teams/$(t)/corrections/$(request.resource.data.appliedCorrection)).data;
      return c.get('itemId', '') == id && c.requesterUid != request.auth.uid && c.status == 'pending';
    }
    // 투표는 내 표만 넣고 뺄 수 있다
    function ownVoteOnly(t) {
      let before = resource.data.get('votes', []).toSet();
      let after = request.resource.data.get('votes', []).toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([myMemberId(t)]);
    }
    function correctionOk(t) {
      let c = get(/databases/$(database)/documents/teams/$(t)/corrections/$(request.resource.data.correctionId)).data;
      return c.kind == 'missing' && c.status == 'pending' // 처리한 요청으로 기록을 계속 찍어낼 수 없다
        && c.memberId == request.resource.data.memberId
        && c.requesterUid == request.resource.data.ownerUid
        && c.requesterUid != request.auth.uid;
    }
    function validNewRecord(t) {
      return (request.resource.data.ownerUid == request.auth.uid
              && request.resource.data.memberId == get(rolePath(t)).data.memberId)
        || (request.resource.data.get('correctionId', null) != null && correctionOk(t))
        // 팀장이 기존 워크스페이스·샘플·파일을 올릴 때: 다른 팀원 이름의 기록은 '가져온 기록'으로 표시
        || (request.resource.data.get('imported', false) == true
              && request.resource.data.ownerUid == request.auth.uid && isOwner(t));
    }

    // 회의를 시작한 사람과 팀장은 회의 기록을 통째로 지울 수 있다 (녹취 원문 포함)
    function canEraseCall(t, c) {
      return isOwner(t)
        || (isMember(t) && get(/databases/$(database)/documents/teams/$(t)/calls/$(c)).data.startedBy == request.auth.uid);
    }

    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      // 만 14세 미만으로 답한 뒤 혼자 '이상'으로 바꿔 보호자 동의를 건너뛸 수 없다
      allow update: if signedIn() && request.auth.uid == uid
        && !(resource.data.get('consent', {}).get('over14', true) == false && request.resource.data.get('consent', {}).get('over14', false) == true);
    }

    // 보호자 동의 요청. 문서 id가 비밀 링크라 id를 아는 사람만 읽고, 목록은 볼 수 없다
    match /guardianRequests/{token} {
      allow get: if signedIn();
      allow create: if signedIn() && token.size() >= 16 && request.resource.data.childUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['childUid', 'status', 'createdAt', 'version']);
      // 결정은 아이 본인이 아닌 다른 계정만, 자기 이름으로만. 이미 결정한 보호자만 바꿀 수 있다
      allow update: if signedIn() && resource.data.childUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guardianUid', 'guardianEmail', 'decidedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'revoked']
        && request.resource.data.guardianUid == request.auth.uid
        && request.auth.token.get('email', '') != '' && request.resource.data.guardianEmail == request.auth.token.email
        && resource.data.get('guardianUid', request.auth.uid) == request.auth.uid;
      allow delete: if signedIn() && (resource.data.childUid == request.auth.uid || resource.data.get('guardianUid', '') == request.auth.uid);
    }

    match /teams/{t} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && consented()
        && !('deleting' in request.resource.data)
        && str(request.resource.data.teamName, 200) && request.resource.data.get('members', []).size() == 0;
      allow read: if isMember(t) || isProf(t);
      // 명단은 roster 문서로 옮겼다. 예전 방의 members 배열은 고칠 수 없다 (읽기만 해서 옮긴다)
      // 연동 대상(links)은 팀장만: 팀원이 피해자의 비공개 저장소를 지정하면 피해자의 토큰으로 내용을 가져와 팀에 공개하게 된다
      allow update: if (isMember(t) && onlyKeys(['teamName', 'course', 'decisionDismissed', 'links'])
          && (!changed('links') || isOwner(t))
          && str(request.resource.data.get('teamName', ''), 200) && str(request.resource.data.get('course', ''), 200))
        // 팀장 넘기기: 받는 사람은 이미 이 방의 팀원이어야 한다
        || (isOwner(t) && onlyKeys(['ownerUid'])
            && get(/databases/$(database)/documents/teams/$(t)/members/$(request.resource.data.ownerUid)).data.role == 'student')
        // 예전 명단 배열은 roster로 옮긴 뒤 팀장이 비운다 (이메일·사진이 남지 않게)
        || (isOwner(t) && onlyKeys(['members']) && request.resource.data.members.size() == 0)
        // 방 삭제 시작 (되돌리는 것도 가능)
        || (isOwner(t) && onlyKeys(['deleting']));
      allow delete: if isOwner(t);

      // 초대 코드: 팀원 코드는 팀원이, 교수자 코드는 팀장만 읽는다. 다시 발급(옛 링크 무효, 기간 새로)은 팀장만
      match /secrets/{kind} {
        allow create: if signedIn() && getAfter(teamPath(t)).data.ownerUid == request.auth.uid
          && str(request.resource.data.code, 100) && request.resource.data.code.size() >= 16;
        allow read: if (kind == 'student' && isMember(t)) || (kind == 'prof' && isOwner(t));
        allow update: if isOwner(t) && onlyKeys(['code', 'expiresAt'])
          && str(request.resource.data.code, 100) && request.resource.data.code.size() >= 16
          && request.resource.data.get('expiresAt', 0) <= request.time.toMillis() + 31 * 24 * 60 * 60 * 1000;
        allow delete: if tearingDown(t);
      }

      // 명단의 팀원 한 명 = 계정 하나. 이미 있는 문서는 다시 만들 수 없어서 먼저 고른 사람만 그 팀원이 된다
      match /claims/{memberId} {
        allow read: if isMember(t);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && getAfter(rolePath(t)).data.role == 'student'
          && getAfter(rolePath(t)).data.memberId == memberId;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(t));
      }

      // 명단: 팀원은 내 칸만, 팀장은 모든 칸을 고친다. 새 칸은 더할 수 있지만 이미 주인이 있는 칸은 만들 수 없다
      match /roster/{memberId} {
        allow read: if isMember(t) || isProf(t);
        allow create: if isMember(t) && validEntry(request.resource.data, memberId)
          && (isOwner(t) || (request.resource.data.get('uid', request.auth.uid) == request.auth.uid
              && (!exists(claimPath(t, memberId)) || get(claimPath(t, memberId)).data.uid == request.auth.uid)));
        allow update: if isMember(t) && validEntry(request.resource.data, memberId)
          && (isOwner(t) || (memberId == myMemberId(t) && request.resource.data.get('uid', request.auth.uid) == request.auth.uid));
        allow delete: if isOwner(t);
      }

      match /members/{uid} {
        // 본인, 그리고 방 관리를 하는 팀장
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(t));
        allow create: if signedIn() && request.auth.uid == uid
          && consented()
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'role', 'memberId', 'code', 'joinedAt', 'name'])
          && str(request.resource.data.get('name', ''), 100)
          && (
            // 팀을 만든 사람 (팀 문서와 같은 배치로 생성)
            (request.resource.data.role == 'student' && getAfter(teamPath(t)).data.ownerUid == uid
              && (request.resource.data.memberId == null || ownsClaimAfter(t, request.resource.data.memberId)))
            // 초대 링크로 참여: 역할에 맞는 코드가 있어야 하고, 팀원 연결은 나중에 한다
            || (request.resource.data.role in ['student', 'prof']
                && request.resource.data.memberId == null
                && validInvite(t, request.resource.data.role, request.resource.data.code))
          );
        // 명단에서 자기 팀원을 고르는 것은 한 번만, 그리고 그 팀원의 claim을 같은 배치에서 차지해야 한다
        allow update: if signedIn() && request.auth.uid == uid
          && resource.data.memberId == null && onlyKeys(['memberId'])
          && ownsClaimAfter(t, request.resource.data.memberId);
        // 예전에 저장한 내 이메일은 지울 수 있다
        allow update: if signedIn() && request.auth.uid == uid && onlyKeys(['email']) && !('email' in request.resource.data);
        // 스스로 나가기 (팀장은 먼저 넘겨야 한다) / 팀장이 내보내기 / 방 삭제 중
        allow delete: if signedIn() && (
          (request.auth.uid == uid && !isOwner(t))
          || (isOwner(t) && request.auth.uid != uid)
          || tearingDown(t)
        );
      }

      match /items/{id} {
        allow read: if (isMember(t) && (resource.data.visibility in ['team', 'prof'] || resource.data.ownerUid == request.auth.uid))
                    || (isProf(t) && resource.data.visibility == 'prof');
        allow create: if isMember(t) && safeId(id) && request.resource.data.get('id', id) == id
          && validNewRecord(t) && validRecord(request.resource.data);
        allow update: if isMember(t) && (
          // 작성자는 자기 기록을 고칠 수 있다 (작성자·팀원 id는 못 바꿈)
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.get('id', id) == id
            && validRecord(request.resource.data))
          // 다른 팀원은 공개된 기록에 내 투표·테이블 이동만.
          // 분류(종류·주제·키워드·목적)는 그 기록의 보정 요청을 확인할 때만, AI 대화 원문은 언제나 못 고친다
          || (resource.data.visibility in ['team', 'prof']
            && onlyKeys(['votes', 'table', 'type', 'themes', 'keywords', 'ai', 'appliedCorrection'])
            && (!changed('votes') || ownVoteOnly(t))
            && (!changed('table') || request.resource.data.table == null || (number(request.resource.data.table.x) && number(request.resource.data.table.y)))
            && (!(changed('type') || changed('themes') || changed('keywords') || changed('ai') || changed('appliedCorrection')) || appliedCorrectionOk(t, id))
            && (!changed('ai') || resource.data.get('ai', null) == null
                || request.resource.data.ai.diff(resource.data.ai).affectedKeys().hasOnly(['purpose'])))
        );
        allow delete: if (isMember(t) && resource.data.ownerUid == request.auth.uid) || tearingDown(t);
      }

      match /itemMeta/{id} {
        allow read: if isMember(t) || isProf(t);
        // 횟수 기록은 실제 기록과 함께만 만든다 (기록 없이 횟수만 늘려 기여를 부풀리지 못하게)
        allow create: if isMember(t) && safeId(id) && validNewRecord(t)
          && existsAfter(/databases/$(database)/documents/teams/$(t)/items/$(id))
          && request.resource.data.visibility in ['me', 'team', 'prof']
          && request.resource.data.type in ['link', 'memo', 'idea', 'ai', 'talk', 'work', 'search'];
        allow update: if isMember(t) && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.memberId == resource.data.memberId)
          // 다른 팀원: 그 기록의 보정 요청을 확인해 분류가 바뀐 경우에만 똑같이 맞춘다
          || (resource.data.visibility in ['team', 'prof'] && onlyKeys(['type', 'purpose'])
              && get(/databases/$(database)/documents/teams/$(t)/items/$(id)).data.get('appliedCorrection', null) != null
              && get(/databases/$(database)/documents/teams/$(t)/items/$(id)).data.type == request.resource.data.type)
        );
        allow delete: if (isMember(t) && resource.data.ownerUid == request.auth.uid) || tearingDown(t);
      }

      match /decisions/{id} {
        allow read: if isMember(t) || isProf(t);
        allow create, update: if isMember(t) && safeId(id) && str(request.resource.data.text, 5000)
          && request.resource.data.get('sourceIds', []) is list && request.resource.data.get('sourceIds', []).size() <= 50;
        allow delete: if isMember(t) || tearingDown(t);
      }

      match /quests/{id} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && str(request.resource.data.get('title', ''), 500);
        allow delete: if isMember(t) || tearingDown(t);
      }

      match /corrections/{id} {
        allow read: if isMember(t);
        // 보정 요청은 내 기여에 대해서만
        allow create: if isMember(t) && safeId(id) && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.memberId == myMemberId(t)
          && request.resource.data.get('status', '') == 'pending';
        // 다른 팀원 한 명이 확인해야 반영된다. 확인자는 자기 자신으로만 남길 수 있다
        allow update: if isMember(t) && resource.data.requesterUid != request.auth.uid
          && onlyKeys(['status', 'confirmedBy'])
          && request.resource.data.status in ['applied', 'rejected']
          && resource.data.status == 'pending' // 한 번 처리한 요청은 되돌리지 못한다
          && request.resource.data.get('confirmedBy', null) == myMemberId(t);
        allow delete: if (isMember(t) && resource.data.requesterUid == request.auth.uid) || tearingDown(t);
      }

      // 기여 보정 변경 이력: 추가만 가능
      match /logs/{id} {
        allow read: if isMember(t) || isProf(t);
        // 누가 남겼는지 함께 기록한다 (남의 이름으로 이력을 위조하지 못하게)
        allow create: if isMember(t) && str(request.resource.data.text, 2000)
          && request.resource.data.by == request.auth.uid;
        allow delete: if tearingDown(t);
      }

      // 음성·화상 회의: 방 팀원만. 녹취 한 줄은 말한 본인만 쓸 수 있다
      match /calls/{c} {
        // 교수자는 팀이 '교수자에게 공유'한 회의만 (요약만 쓰고 녹취 lines는 못 읽는다)
        allow read: if isMember(t) || (isProf(t) && resource.data.shareProf == true);
        allow create: if isMember(t) && safeId(c) && request.resource.data.startedBy == request.auth.uid
          && request.resource.data.status in ['live', 'ended'] && str(request.resource.data.title, 200)
          && request.resource.data.get('shareProf', false) == false;
        allow update: if isMember(t)
          && onlyKeys(['status', 'endedAt', 'summary', 'summaryBy', 'attendees', 'lineCount', 'shareProf', 'decisions', 'closedBy'])
          && request.resource.data.status in ['live', 'ended']
          // 끝난 회의를 다시 열 수 없다
          && !(resource.data.status == 'ended' && request.resource.data.status != 'ended')
          && (request.resource.data.get('summary', null) == null || str(request.resource.data.summary, 50000))
          && (!changed('closedBy') || request.resource.data.closedBy == request.auth.uid)
          // 이미 저장된 요약은 다른 팀원이 고쳐 쓸 수 없다
          && (!(changed('summary') || changed('decisions') || changed('attendees') || changed('lineCount')) || resource.data.get('summary', null) == null)
          // 교수자에게 공유하는 것은 회의를 시작한 사람이나 팀장만 정한다
          && (!changed('shareProf') || resource.data.startedBy == request.auth.uid || isOwner(t));
        allow delete: if canEraseCall(t, c);

        match /peers/{uid} {
          allow read: if isMember(t);
          allow create, update: if isMember(t) && request.auth.uid == uid && str(request.resource.data.get('name', ''), 100);
          allow delete: if (isMember(t) && request.auth.uid == uid) || canEraseCall(t, c);
        }
        // 연결 정보: 보낸 사람이 만들고, 받는 사람만 읽고 지운다. 못 받은 신호는 보낸 사람이 나갈 때 치운다
        match /signals/{s} {
          allow create: if isMember(t) && request.resource.data.from == request.auth.uid;
          allow read, delete: if (isMember(t) && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid))
                              || canEraseCall(t, c);
        }
        match /lines/{l} {
          allow read: if isMember(t);
          allow create: if isMember(t) && request.resource.data.uid == request.auth.uid && str(request.resource.data.text, 5000);
          // 내가 한 말은 내가 지울 수 있다. 회의 전체 삭제는 시작한 사람·팀장
          allow delete: if (isMember(t) && resource.data.uid == request.auth.uid) || canEraseCall(t, c);
        }
      }

      // 실시간 접속 표시 (RQ-8): 본인 것만 쓰고 팀원이 읽는다. 다른 팀원 이름으로는 표시할 수 없다
      match /presence/{uid} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && request.auth.uid == uid
          && (request.resource.data.memberId == null || request.resource.data.memberId == myMemberId(t))
          && number(request.resource.data.at);
        allow delete: if (isMember(t) && request.auth.uid == uid) || tearingDown(t);
      }

      // 권한 없는 접근 시도 기록 (ONRQ-5): 누구나 남길 수 있고 팀장만 읽는다
      // 계정·종류마다 하루 한 건 (id = uid_종류_날짜) 이라 낯선 사람이 기록을 쏟아내 채우지 못한다
      match /accessLogs/{id} {
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && id.matches('^' + request.auth.uid + '_[a-z-]{1,20}_[0-9]{8}$')
          && request.resource.data.keys().hasOnly(['uid', 'what', 'at'])
          && str(request.resource.data.get('what', ''), 40);
        allow read: if isOwner(t) || (signedIn() && resource.data.uid == request.auth.uid);
        // 팀장은 30일 지난 기록을 지운다. 본인 기록은 본인이 지운다 (계정 삭제)
        allow delete: if isOwner(t) || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
